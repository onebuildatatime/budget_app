{
  "name": "budget-mobile-app",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:model",
    "test:model": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build:ios": "npm exec --yes --cache /tmp/npm-cache-eas-build -- eas-cli build --platform ios --profile production --clear-cache",
    "submit:ios": "npm exec --yes --cache /tmp/npm-cache-eas-submit -- eas-cli submit --platform ios --profile production --latest --wait --verbose"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@types/react": "~19.2.10",
    "expo": "~57.0.23",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-pdf-text-extract": "^1.0.1",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.11.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.0",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-pdf-text-extract",
          "firebase",
          "pdf-lib",
          "pdfjs-dist",
          "react-native-confetti-cannon",
          "xlsx"
        ]
      }
    }
  }
}
